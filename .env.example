# Environment Configuration Baseline
ENV=development

# Database Configuration
POSTGRES_USER=tms_user
POSTGRES_PASSWORD=tms_password
POSTGRES_DB=tms_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://tms_user:tms_password@postgres:5432/tms_db

# Redis & Queue Broker Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Security & Authentication
JWT_SECRET=super-secret-jwt-key-change-in-production-min-32-chars
JWT_REFRESH_SECRET=super-secret-jwt-refresh-key-change-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Storage Configuration (local | s3)
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./uploads
S3_BUCKET=tms-storage-bucket
S3_ENDPOINT=https://s3.amazonaws.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=ap-south-1

# Notification Configuration (mock | twilio | gupshup)
NOTIFICATION_PROVIDER=mock
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@tms.local

# Frontend Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
